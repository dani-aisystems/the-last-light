"mode":"thought","name":"","speaker":"","text":"The torch first, top shelf by the door. Then the engine, and the lights. Then lighting-up time, and the long quiet."}],"in_beat":false,"layout":3,"log_written":[],"obj_done":[],"objective":"","play_seconds":0.566666666666667,"rel":{"elspeth":0,"morag":0,"ross":0},"rescues":{},"resume":[]},"version":1}